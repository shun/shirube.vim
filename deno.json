{
  "name": "@shun/shirube-vim",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "imports": {
    "@denops/std": "jsr:@denops/std",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/assert": "jsr:@std/assert@^0.224.0"
  },
  "license": "MIT",
  "readme": "README.md",
  "tasks": {
    "publish": "deno run --allow-run --allow-read scripts/publish.ts",
    "publish:dry-run": "deno run --allow-run --allow-read scripts/publish.ts --dry-run --allow-dirty",
    "test": "deno test --allow-read --allow-env --allow-write"
  },
  "lint": {
    "include": [
      "src",
      "denops",
      "mod.ts",
      "docs"
    ],
    "exclude": [
      "tmp"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "include": [
      "src",
      "denops",
      "mod.ts"
    ],
    "exclude": [
      "docs",
      "tmp"
    ],
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true
  }
}
